# App
NODE_ENV=development
PORT=5000
WEB_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/stockpulse
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Market data provider
MARKET_DATA_PROVIDER=primary
MARKET_DATA_API_KEY=

# News provider
NEWS_PROVIDER=primary
NEWS_API_KEY=

# Sentiment provider
SENTIMENT_PROVIDER=primary
SENTIMENT_API_KEY=

# AI
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional notifications
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Logging
LOG_LEVEL=info
